# ===================================================
# Wildlife Population Intelligence System
# Environment Configuration Example
# Copy this to .env and fill in actual values
# ===================================================

# ===================================================
# APPLICATION SETTINGS
# ===================================================
ENVIRONMENT=development
DEBUG=True
API_TITLE=Wildlife Population Intelligence System
API_VERSION=1.0.0

# ===================================================
# DATABASE
# ===================================================
# PostgreSQL (Production)
DATABASE_URL=postgresql://wildlife_user:wildlife_password@localhost:5432/wildlife_db

# SQLite (Development - uncomment to use)
# DATABASE_URL=sqlite:///wildlife.db

# ===================================================
# SECURITY & JWT
# ===================================================
JWT_SECRET_KEY=your-super-secret-key-change-in-production-12345678901234567890
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# ===================================================
# FRONTEND
# ===================================================
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ===================================================
# FILE UPLOAD
# ===================================================
UPLOAD_DIR=/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a,aac,flac

# ===================================================
# MACHINE LEARNING MODELS
# ===================================================
IMAGE_MODEL_PATH=/models/yolov8
AUDIO_MODEL_PATH=/models/birdnet

# ===================================================
# LOGGING
# ===================================================
LOG_LEVEL=INFO
LOG_FILE=wildlife.log

# ===================================================
# EMAIL (OPTIONAL)
# ===================================================
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ===================================================
# AI/LLM INTEGRATION (PHASE 10)
# ===================================================
AI_PROVIDER=openai
AI_MODEL=gpt-4
AI_API_KEY=
AI_MAX_TOKENS=1000

# ===================================================
# EXTERNAL SERVICES (PHASE 4)
# ===================================================
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GOOGLE_MAPS_API_KEY=
MAPBOX_API_KEY=

# ===================================================
# CLOUD DEPLOYMENT (PHASE 4)
# ===================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=wildlife-data

AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_STORAGE_ACCOUNT=

# ===================================================
# MONITORING & ALERTS
# ===================================================
SENTRY_DSN=
DATADOG_API_KEY=

# ===================================================
# CELERY (Task Queue - Optional)
# ===================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===================================================
# REDIS (Caching - Optional)
# ===================================================
REDIS_URL=redis://localhost:6379/0

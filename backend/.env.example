# Copy this file to .env and adjust values

# Default: SQLite - works immediately with no extra setup.
DATABASE_URL=sqlite:///./wildlife.db

# Switch to Postgres/PostGIS (production-shaped, needed before Milestone 4's
# geospatial features) by commenting the line above and uncommenting this one:
# DATABASE_URL=postgresql+psycopg2://wildlife_user:wildlife_pass@localhost:5432/wildlife_db

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token - lets the frontend silently get a new access token without
# forcing the user to log in again every 60 minutes
REFRESH_SECRET_KEY=change-this-to-a-different-long-random-string
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - comma separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File uploads (dataset sample files / observation captures)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# App
PROJECT_NAME=Wildlife Population Intelligence System
API_V1_PREFIX=/api/v1

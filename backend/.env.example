# Copy this file to .env and fill in real values before running the app

# --- Database ---
# SQLite (default, zero-install, good for local dev):
DATABASE_URL=sqlite:///./wildlife_intelligence.db
# To use PostgreSQL instead, comment out the line above and uncomment/edit this one:
# DATABASE_URL=postgresql://wpi_user:wpi_password@localhost:5432/wildlife_intelligence_db

# --- Auth ---
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
ENVIRONMENT=development
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI Models ---
# Defaults to the stock YOLOv8 COCO checkpoint (auto-downloaded).
# After training a wildlife-specific model (see backend/training/), point
# this at your checkpoint, e.g.: app/ml_models/wildlife_yolov8_best.pt
YOLO_MODEL_PATH=yolov8n.pt
